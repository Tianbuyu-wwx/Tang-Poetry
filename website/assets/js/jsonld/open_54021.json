{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_54021","headline":"寄步非烟（题拟） · 赵象","name":"寄步非烟（题拟）","inLanguage":"zh-Hans","text":"见说伤情爲见春，想封蝉锦绿蛾颦。\n叩头爲报烟卿道，第一风流最损人。","author":{"@type":"Person","name":"赵象","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_54021.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_54021","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"七言绝句","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}