{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_07586","headline":"江有归舟三章 一 · 萧颖士","name":"江有归舟三章 一","inLanguage":"zh-Hans","text":"江有归舟，亦乱其流。\n之子言旋，嘉名孔修。\n扬于王庭，允焯其休。","author":{"@type":"Person","name":"萧颖士","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_07586.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_07586","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"杂言古诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}