{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_10691","headline":"遣兴五首 二 · 杜甫","name":"遣兴五首 二","inLanguage":"zh-Hans","text":"长陵锐头儿，出猎待明发。\n騂弓金爪镝，白马蹴微雪。\n未知所驰逐，但见暮光灭。\n归来悬两狼，门户有旌节。","author":{"@type":"Person","name":"杜甫","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_10691.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_10691","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}