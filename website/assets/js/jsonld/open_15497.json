{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_15497","headline":"荐福寺送元伟 · 李端","name":"荐福寺送元伟","inLanguage":"zh-Hans","text":"送客攀花後，寻僧坐竹时。\n明朝莫回望，青草马行迟。","author":{"@type":"Person","name":"李端","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_15497.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_15497","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言绝句","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}