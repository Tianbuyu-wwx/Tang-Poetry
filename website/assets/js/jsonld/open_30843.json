{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_30843","headline":"离夜二首 二 · 马戴","name":"离夜二首 二","inLanguage":"zh-Hans","text":"凝夜照离色，恐闻啼晚鸦。\n前年营鴈塞，明月戍龙沙。\n曾与五陵子，休装孤剑花。","author":{"@type":"Person","name":"马戴","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_30843.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_30843","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言古诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}