{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_37611","headline":"郊野 · 郑谷","name":"郊野","inLanguage":"zh-Hans","text":"蓼水菊篱边，新晴有乱蝉。\n秋光终寂寞，晚醉自留连。\n野湿禾中露，村闲社後天。\n题诗满红叶，何必浣花牋。","author":{"@type":"Person","name":"郑谷","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_37611.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_37611","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}