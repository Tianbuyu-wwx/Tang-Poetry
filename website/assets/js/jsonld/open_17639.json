{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_17639","headline":"南馆林塘 · 羊士谔","name":"南馆林塘","inLanguage":"zh-Hans","text":"郡阁山斜对，风烟隔短墙。\n清池如写月，珍树尽凌霜。\n行乐知无闷，加餐颇自强。\n心期空岁晚，鱼意久相忘。","author":{"@type":"Person","name":"羊士谔","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_17639.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_17639","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}