{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_49482","headline":"浣溪沙 五 · 顾敻","name":"浣溪沙 五","inLanguage":"zh-Hans","text":"庭菊飘黄玉露浓，冷莎偎砌隐鸣蛩，何期良夜得相逢。\n背帐风摇红蜡滴，惹香煖梦绣衾重，觉来枕上怯晨钟。","author":{"@type":"Person","name":"顾敻","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_49482.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_49482","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"七言古诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}