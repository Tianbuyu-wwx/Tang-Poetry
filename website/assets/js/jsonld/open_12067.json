{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_12067","headline":"初至巴陵与李十二白裴九同泛洞庭湖三首 二 · 贾至","name":"初至巴陵与李十二白裴九同泛洞庭湖三首 二","inLanguage":"zh-Hans","text":"枫岸纷纷落叶多，洞庭秋水晚来波。\n乘兴轻舟无近远，白云明月吊湘娥。","author":{"@type":"Person","name":"贾至","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_12067.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_12067","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"七言绝句","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}