{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_26618","headline":"别贾岛 · 姚合","name":"别贾岛","inLanguage":"zh-Hans","text":"嬾作住山人，贫家日赁身。\n书多笔渐重，睡少枕长新。\n野客狂无过，诗仙瘦始真。\n秋风千里去，谁与我相亲。","author":{"@type":"Person","name":"姚合","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_26618.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_26618","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}