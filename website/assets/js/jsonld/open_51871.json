{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_51871","headline":"牡丹 · 无名氏","name":"牡丹","inLanguage":"zh-Hans","text":"倾国姿容别，多开富贵家。\n临轩一赏後，轻薄万千花。\n（同上《草木典》二八九《牡丹部》）。","author":{"@type":"Person","name":"无名氏","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_51871.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_51871","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"古风","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}