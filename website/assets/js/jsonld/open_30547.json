{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_30547","headline":"汉阴庭树 · 赵嘏","name":"汉阴庭树","inLanguage":"zh-Hans","text":"掘沟引水浇蔬圃，插竹爲篱护药苗。\n杨柳如丝风易乱，梅花似雪日难消。","author":{"@type":"Person","name":"赵嘏","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_30547.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_30547","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"七言绝句","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}