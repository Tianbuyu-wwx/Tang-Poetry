{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_00063","headline":"冬宵各爲四韵 · 太宗皇帝","name":"冬宵各爲四韵","inLanguage":"zh-Hans","text":"雕宫静龙漏，绮阁宴公侯。\n珠帘烛焰动，绣柱月光浮。\n云起将歌发，风停与管遒。","author":{"@type":"Person","name":"太宗皇帝","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_00063.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_00063","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言古诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}