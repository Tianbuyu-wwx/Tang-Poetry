{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_37872","headline":"读段太尉碑 · 崔涂","name":"读段太尉碑","inLanguage":"zh-Hans","text":"愤激计潜成，临危岂顾生。\n秪空持一笏，便欲碎长鲸。\n国已酬徽烈，家犹耸义声。\n不知青史上，谁可计功名。","author":{"@type":"Person","name":"崔涂","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_37872.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_37872","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}