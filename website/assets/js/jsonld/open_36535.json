{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_36535","headline":"竹 · 罗邺","name":"竹","inLanguage":"zh-Hans","text":"翠叶才分细细枝，清阴犹未上阶墀。\n蕙兰虽许相依日，桃李还应笑後时。\n抱节不爲霜霰改，成林终与凤凰期。\n渭滨若更徵贤相，好作渔竿系钓丝。","author":{"@type":"Person","name":"罗邺","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_36535.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_36535","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"七言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}