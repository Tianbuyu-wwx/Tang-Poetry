{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_14010","headline":"会凤翔张少尹南亭 · 耿湋","name":"会凤翔张少尹南亭","inLanguage":"zh-Hans","text":"远过张正见，诗兴自依依。\n西府军城暮，南庭吏事稀。\n草檐宜日过，花圃任烟归。\n更料重关外，羣僚候启扉。","author":{"@type":"Person","name":"耿湋","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_14010.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_14010","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}