{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_10312","headline":"玉山岭上作 · 皇甫曾","name":"玉山岭上作","inLanguage":"zh-Hans","text":"悠悠驱匹马，征路上连冈。\n晚翠深云窦，寒台净石梁。\n秋花偏似雪，枫叶不禁霜。\n愁见前程远，空郊下夕阳。","author":{"@type":"Person","name":"皇甫曾","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_10312.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_10312","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}