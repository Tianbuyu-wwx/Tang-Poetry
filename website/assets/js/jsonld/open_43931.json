{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_43931","headline":"古意 · 张夫人","name":"古意","inLanguage":"zh-Hans","text":"辘轳晓转素丝绠，桐声夜落苍苔塼。\n涓涓吹溜若时雨，濯濯佳蔬非用天。\n丈夫不解此中意，抱瓮当时徒自贤。","author":{"@type":"Person","name":"张夫人","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_43931.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_43931","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"七言古诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}