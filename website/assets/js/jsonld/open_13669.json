{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_13669","headline":"送舍弟 · 严维","name":"送舍弟","inLanguage":"zh-Hans","text":"疎懒吾成性，才华尔自强。\n早称眉最白，何事绶仍黄。\n时暑嗟于迈，家贫念聚粮。\n秪应宵梦里，诗兴属池塘。","author":{"@type":"Person","name":"严维","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_13669.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_13669","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}