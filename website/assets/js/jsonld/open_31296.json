{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_31296","headline":"冬夜旅怀 · 刘威","name":"冬夜旅怀","inLanguage":"zh-Hans","text":"寒窗危竹枕，月过半牀阴。\n嫩叶不归梦，晴虫成苦吟。\n酒无通夜力，事满五更心。\n寂寞谁相似，残灯与素琴。","author":{"@type":"Person","name":"刘威","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_31296.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_31296","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}