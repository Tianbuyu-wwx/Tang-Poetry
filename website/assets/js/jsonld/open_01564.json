{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_01564","headline":"琴曲歌辞  秋思 · 司空图","name":"琴曲歌辞  秋思","inLanguage":"zh-Hans","text":"身病时亦危，逢秋多恸哭。\n风波一摇荡，天地几翻覆。\n孤萤出荒池，落叶穿破屋。","author":{"@type":"Person","name":"司空图","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_01564.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_01564","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"乐府","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}