{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_27147","headline":"宿李枢书斋 · 周贺","name":"宿李枢书斋","inLanguage":"zh-Hans","text":"小斋经暮雨，四面绝纤埃。\n眠客闻风觉，飞虫入烛来。\n夜凉书读遍，月正户全开。\n住远稀相见，留连宿始回。","author":{"@type":"Person","name":"周贺","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_27147.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_27147","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}