{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_40434","headline":"石头怀古 · 曹松","name":"石头怀古","inLanguage":"zh-Hans","text":"日月出又没，台城空白云。\n虽宽百姓土，渐缺六朝坟。\n禾黍是亡国，山河归圣君。\n松声骤雨足，几寺晚钟闻。","author":{"@type":"Person","name":"曹松","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_40434.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_40434","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}