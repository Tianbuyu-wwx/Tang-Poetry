{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_43936","headline":"句 · 张夫人","name":"句","inLanguage":"zh-Hans","text":"游蜂乍起惊落墀，黄鸟衔来却上枝。\n临风重回首，掩泪向庭花。\n镜中春色老，枕前秋夜长。","author":{"@type":"Person","name":"张夫人","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_43936.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_43936","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"杂言古诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}