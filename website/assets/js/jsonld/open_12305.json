{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_12305","headline":"酬卢十一过宿 · 钱起","name":"酬卢十一过宿","inLanguage":"zh-Hans","text":"乞还方未遂，日夕望云林。\n况复逢青草，何妨问此心。\n闭门公务散，枉策故情深。\n遥夜他乡宿，同君梁甫吟。","author":{"@type":"Person","name":"钱起","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_12305.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_12305","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}