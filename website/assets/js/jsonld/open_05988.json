{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_05988","headline":"送李员外贤郎 · 王维","name":"送李员外贤郎","inLanguage":"zh-Hans","text":"少年何处去，负米上铜梁。\n借问阿戎父，知爲童子郎。\n鱼牋请诗赋，橦布作衣裳。\n薏苡扶衰病，归来幸可将。","author":{"@type":"Person","name":"王维","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_05988.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_05988","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}