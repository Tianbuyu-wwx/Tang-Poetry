{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_17643","headline":"酬礼部崔员外备独永宁里弊居见寄来诗云图书锁尘阁符节守山城 · 羊士谔","name":"酬礼部崔员外备独永宁里弊居见寄来诗云图书锁尘阁符节守山城","inLanguage":"zh-Hans","text":"守土亲巴俗，腰章囗汉仪。\n春行乐职咏，秋感伴牢词。\n旧里藏书阁，闲门闭槿篱。\n遥慙退朝客，下马独相思。","author":{"@type":"Person","name":"羊士谔","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_17643.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_17643","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}