{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_20806","headline":"出山作 · 卢仝","name":"出山作","inLanguage":"zh-Hans","text":"出山忘掩山门路，钓竿插在枯桑树。\n当时只有鸟窥窬，更亦无人得知处。\n家僮若失钓鱼竿，定是猨猴把将去。","author":{"@type":"Person","name":"卢仝","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_20806.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_20806","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"七言古诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}