{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_12066","headline":"初至巴陵与李十二白裴九同泛洞庭湖三首 一 · 贾至","name":"初至巴陵与李十二白裴九同泛洞庭湖三首 一","inLanguage":"zh-Hans","text":"江上相逢皆旧游，湘山永望不堪愁。\n明月秋风洞庭水，孤鸿落叶一扁舟。","author":{"@type":"Person","name":"贾至","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_12066.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_12066","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"七言绝句","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}