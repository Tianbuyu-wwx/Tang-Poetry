{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_48933","headline":"片石 · 唐彦谦","name":"片石","inLanguage":"zh-Hans","text":"小斋庐阜石，寄自沃洲僧。\n山客劳携笈，幽人自得朋。\n瘦云低作段，野浪冻成云。\n便可同清话，何须有物凭。","author":{"@type":"Person","name":"唐彦谦","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_48933.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_48933","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}