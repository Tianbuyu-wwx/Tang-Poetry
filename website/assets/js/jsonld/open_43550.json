{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_43550","headline":"赋应门照绿苔 · 李益","name":"赋应门照绿苔","inLanguage":"zh-Hans","text":"宫阙何年月，应门何岁苔。\n清光一以照，白露共裴回。\n珠履久行绝，玉房重未开。\n妾心正如此，昭阳歌吹来。","author":{"@type":"Person","name":"李益","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_43550.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_43550","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}