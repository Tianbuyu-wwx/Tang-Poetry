{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_44029","headline":"长相思 · 郎大家宋氏","name":"长相思","inLanguage":"zh-Hans","text":"长相思，久离别。\n关山阻，风烟绝。\n台上镜文销，袖中书字灭。\n不见君形影，何曾有欢悦。","author":{"@type":"Person","name":"郎大家宋氏","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_44029.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_44029","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"杂言古诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}