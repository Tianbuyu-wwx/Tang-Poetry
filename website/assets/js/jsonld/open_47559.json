{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_47559","headline":"五言 二 · 吕岩","name":"五言 二","inLanguage":"zh-Hans","text":"姹女住南方，身边产太阳。\n蟾宫烹玉液，坎户炼琼浆。\n过去神仙饵，今来到我尝。\n一杯延万纪，物外任翺翔。","author":{"@type":"Person","name":"吕岩","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_47559.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_47559","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}