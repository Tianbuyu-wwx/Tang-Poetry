{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_42598","headline":"句 · 翁宏","name":"句","inLanguage":"zh-Hans","text":"万木横秋里，孤舟半夜猨。\n漏光残井甃，缺影背山椒。\n风回山火断，潮落岸冰高。","author":{"@type":"Person","name":"翁宏","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_42598.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_42598","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言古诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}