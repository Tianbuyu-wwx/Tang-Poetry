{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_39637","headline":"送友人边游 · 黄滔","name":"送友人边游","inLanguage":"zh-Hans","text":"衔杯国门外，分手见残阳。\n何日还南越，今朝往北荒。\n砂城经雨坏，虏骑入秋狂。\n亲咏关山月，归吟鬓的霜。","author":{"@type":"Person","name":"黄滔","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_39637.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_39637","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}