{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_17876","headline":"发潭州寄李宁常侍 · 令狐楚","name":"发潭州寄李宁常侍","inLanguage":"zh-Hans","text":"君今侍紫垣，我已堕青天。\n委废从兹日，旋归在几年。\n心爲西靡树，眼是北流泉。\n更过长沙去，江风满驿船。","author":{"@type":"Person","name":"令狐楚","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_17876.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_17876","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}