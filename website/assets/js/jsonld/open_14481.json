{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_14481","headline":"送僧南归 · 戴叔伦","name":"送僧南归","inLanguage":"zh-Hans","text":"兵尘犹澒洞，僧舍亦徵求。\n师向江南去，予方毂下留。\n风霜两足白，宇宙一身浮。\n归及梅花发，题诗寄陇头。","author":{"@type":"Person","name":"戴叔伦","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_14481.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_14481","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}