{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_41400","headline":"七岁吟 · 潘佑","name":"七岁吟","inLanguage":"zh-Hans","text":"朝游沧海东，暮归何太速。\n祗因骑折白龙腰，谪向人间三十六。","author":{"@type":"Person","name":"潘佑","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_41400.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_41400","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"乐府","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}