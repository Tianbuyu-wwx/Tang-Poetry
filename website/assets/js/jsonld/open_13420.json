{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_13420","headline":"庭柳 · 姚系","name":"庭柳","inLanguage":"zh-Hans","text":"褭褭柳杨枝，当轩杂佩垂。\n交阴总共密，分条各自宜。\n因依似永久，揽结更伤离。\n爱此阳春色，秋风莫遽吹。","author":{"@type":"Person","name":"姚系","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_13420.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_13420","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}