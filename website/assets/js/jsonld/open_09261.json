{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_09261","headline":"晓至园中忆诸弟崔都水 · 韦应物","name":"晓至园中忆诸弟崔都水","inLanguage":"zh-Hans","text":"山郭恒悄悄，林月亦娟娟。\n景清神已澄，事简虑绝牵。\n秋塘徧衰草，晓露洗红莲。\n不见心所爱，兹赏岂爲妍。","author":{"@type":"Person","name":"韦应物","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_09261.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_09261","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}