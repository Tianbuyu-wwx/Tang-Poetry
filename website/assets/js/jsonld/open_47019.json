{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_47019","headline":"寄南岳白莲道士能于长啸 · 齐己","name":"寄南岳白莲道士能于长啸","inLanguage":"zh-Hans","text":"猨猱休啼月皎皎，蟋蟀不吟山悄悄。\n大耳仙人满颔须，醉倚长松一声啸。","author":{"@type":"Person","name":"齐己","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_47019.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_47019","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"七言绝句","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}