{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_21131","headline":"遣兴十首 八 · 元稹","name":"遣兴十首 八","inLanguage":"zh-Hans","text":"㸌㸌刀刃光，弯弯弓面张。\n入水斩犀兕，上山椎虎狼。\n里中无老少，唤作癫儿郎。\n一日风云会，横行归故乡。","author":{"@type":"Person","name":"元稹","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_21131.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_21131","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}