{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_03661","headline":"歌 · 李峤","name":"歌","inLanguage":"zh-Hans","text":"汉帝临汾水，周仙去洛滨。\n郢中吟白雪，梁上绕飞尘。\n响发行云驻，声随子夜新。\n愿君听扣角，当自识贤臣。","author":{"@type":"Person","name":"李峤","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_03661.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_03661","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"乐府","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}