{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_32893","headline":"园居 · 李郢","name":"园居","inLanguage":"zh-Hans","text":"暮雨杨雄宅，秋风向秀园。\n不闻砧杵动，时看桔槔翻。\n钓下鱼初食，船移鸭蹔喧。\n橘寒才弄色，须带早霜繁。","author":{"@type":"Person","name":"李郢","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_32893.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_32893","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}