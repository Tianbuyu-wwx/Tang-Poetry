{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_28220","headline":"闲居 · 李远","name":"闲居","inLanguage":"zh-Hans","text":"尘事久相弃，沈浮皆不知。\n牛羊归古巷，燕雀遶疎篱。\n买药经年晒，留僧尽日棊。\n唯忧钓鱼伴，秋水隔波时。","author":{"@type":"Person","name":"李远","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_28220.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_28220","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}