{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_11579","headline":"树间 · 杜甫","name":"树间","inLanguage":"zh-Hans","text":"岑寂双甘树，婆娑一院香。\n交柯低几杖，垂实碍衣裳。\n满岁如松碧，同时待菊黄。\n几回沾叶露，乘月坐胡牀。","author":{"@type":"Person","name":"杜甫","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_11579.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_11579","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}