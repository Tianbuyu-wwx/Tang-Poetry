{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_16760","headline":"酒席赋得匏瓢 · 郑审","name":"酒席赋得匏瓢","inLanguage":"zh-Hans","text":"华阁与贤开。\n仙瓢自远来，幽林尝伴许。\n陋巷亦随回，挂影怜红壁。\n倾心向绿杯，何曾斟酌处。\n不使玉山颓。","author":{"@type":"Person","name":"郑审","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_16760.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_16760","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}