{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_12727","headline":"春夜皇甫冉宅欢宴 · 张继","name":"春夜皇甫冉宅欢宴","inLanguage":"zh-Hans","text":"流落时相见，悲欢共此情。\n兴因尊酒洽，愁爲故人轻。\n暗滴花茎露，斜晖月过城。\n那知横吹笛，江外作边声。","author":{"@type":"Person","name":"张继","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_12727.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_12727","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}