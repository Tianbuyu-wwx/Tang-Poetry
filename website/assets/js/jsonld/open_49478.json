{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_49478","headline":"浣溪沙 一 · 顾敻","name":"浣溪沙 一","inLanguage":"zh-Hans","text":"春色迷人恨正赊，可堪荡子不还家，细风轻露着梨花。\n帘外有情双燕扬，槛前无力绿杨斜，小屏狂梦极天涯。","author":{"@type":"Person","name":"顾敻","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_49478.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_49478","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"七言古诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}