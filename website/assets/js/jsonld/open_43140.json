{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_43140","headline":"南源山 · 姚偓","name":"南源山","inLanguage":"zh-Hans","text":"修径投幽隐，轻裘怯暮寒。\n闲僧能解榻，倦客得休鞍。\n白雨鸣山麓，青灯语夜阑。\n明朝梯石路，更仗笋舆安。","author":{"@type":"Person","name":"姚偓","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_43140.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_43140","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}