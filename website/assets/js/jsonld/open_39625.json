{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_39625","headline":"贻林铎 · 黄滔","name":"贻林铎","inLanguage":"zh-Hans","text":"终被春闱屈，低回至白头。\n寄家僧许岳，钓浦雨移洲。\n战士曾怜善，豪门不信愁。\n王孙草还绿，何处拟羁游。","author":{"@type":"Person","name":"黄滔","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_39625.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_39625","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}