{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_48809","headline":"送令狐明府 · 皇甫冉","name":"送令狐明府","inLanguage":"zh-Hans","text":"行当腊候晚，共惜岁阴残。\n闻道巴山远，如何蜀路难。\n荒林藏积雪，乱石起惊湍。\n君有亲人术，应令劳者安。","author":{"@type":"Person","name":"皇甫冉","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_48809.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_48809","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}