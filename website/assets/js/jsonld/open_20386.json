{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_20386","headline":"律僧 · 张籍","name":"律僧","inLanguage":"zh-Hans","text":"苦行长不出，清羸最少年。\n持斋唯一食，讲律岂曾眠。\n避草每移径，滤虫还入泉。\n从来天竺法，到此几人传。","author":{"@type":"Person","name":"张籍","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_20386.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_20386","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}