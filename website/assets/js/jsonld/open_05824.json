{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_05824","headline":"扶南曲歌词五首 二 · 王维","name":"扶南曲歌词五首 二","inLanguage":"zh-Hans","text":"堂上青弦动，堂前绮席陈。\n齐歌卢女曲，双舞洛阳人。\n倾国徒相看，宁知心所亲。","author":{"@type":"Person","name":"王维","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_05824.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_05824","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"乐府","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}