{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_04988","headline":"长安道 · 沈佺期","name":"长安道","inLanguage":"zh-Hans","text":"秦地平如掌，层城入云汉。\n楼阁九衢春，车马千门旦。\n绿槐开复合，红尘聚还散。\n日晚鬬鸡还，经过狭斜看。","author":{"@type":"Person","name":"沈佺期","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_04988.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_04988","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}