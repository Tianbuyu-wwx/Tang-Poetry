{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_35824","headline":"秋望 · 李咸用","name":"秋望","inLanguage":"zh-Hans","text":"云阴惨澹柳阴稀，游子天涯一望时。\n风闪雁行疎又密，地回江势急还迟。\n荣枯物理终难测，贵贱人生自不知。\n未达谁能多叹息，尘埃争损得男儿。","author":{"@type":"Person","name":"李咸用","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_35824.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_35824","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"七言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}