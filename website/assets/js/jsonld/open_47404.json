{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_47404","headline":"题霍山秦尊师 · 杜光庭","name":"题霍山秦尊师","inLanguage":"zh-Hans","text":"老鹤玄猿伴采芝，有时长叹独移时。\n翠娥红粉婵娟劒，杀尽世人人不知。","author":{"@type":"Person","name":"杜光庭","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_47404.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_47404","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"七言绝句","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}