{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_18561","headline":"方城 四 · 柳宗元","name":"方城 四","inLanguage":"zh-Hans","text":"其良既宥，告以父母。\n恩柔于肌，卒贡尔有。\n维彼攸恃，乃侦乃诱维彼攸宅，乃发乃守。","author":{"@type":"Person","name":"柳宗元","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_18561.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_18561","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"古风","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}