{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_35297","headline":"送友人归袁州 · 张乔","name":"送友人归袁州","inLanguage":"zh-Hans","text":"袁江猨鸟清，曾向此中行。\n才子登科去，诸侯扫榻迎。\n山藏明月浦，树遶白云城。\n远想安亲後，秋风梦不惊。","author":{"@type":"Person","name":"张乔","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_35297.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_35297","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}