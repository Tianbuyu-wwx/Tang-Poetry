{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_19753","headline":"题从叔园林 · 吕温","name":"题从叔园林","inLanguage":"zh-Hans","text":"阮宅闲园暮，窻中见树阴。\n樵歌依野草，僧语过长林。\n鸟向花间井，人弹竹里琴。\n自嫌身未老，已有住山心。","author":{"@type":"Person","name":"吕温","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_19753.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_19753","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}