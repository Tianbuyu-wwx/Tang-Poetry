{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_45857","headline":"寄栖一上人 · 贯休","name":"寄栖一上人","inLanguage":"zh-Hans","text":"花堑接沧洲，阴云闲楚丘。\n雨声虽到夜，吟味不如秋。\n古屋藏花鸽，荒园聚乱流。\n无机心便是，何用话归休。","author":{"@type":"Person","name":"贯休","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_45857.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_45857","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}