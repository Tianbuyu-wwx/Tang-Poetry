{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_05588","headline":"永嘉作 · 张子容","name":"永嘉作","inLanguage":"zh-Hans","text":"拙宦从江左，投荒更海边。\n山将孤屿近，水共恶谿连。\n地湿梅多雨，潭蒸竹起烟。\n未应悲晚髪，炎瘴苦华年。","author":{"@type":"Person","name":"张子容","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_05588.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_05588","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}