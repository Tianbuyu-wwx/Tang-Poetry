{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_16482","headline":"殷秀才求诗 · 刘商","name":"殷秀才求诗","inLanguage":"zh-Hans","text":"倾盖见芳姿，晴天琼树枝。\n连城犹隐石，唯有卞和知。","author":{"@type":"Person","name":"刘商","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_16482.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_16482","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言绝句","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}