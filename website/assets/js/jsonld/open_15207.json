{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_15207","headline":"汴河曲 · 李益","name":"汴河曲","inLanguage":"zh-Hans","text":"汴水东流无限春，隋家宫阙已成尘。\n行人莫上长堤望，风起杨花愁杀人。","author":{"@type":"Person","name":"李益","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_15207.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_15207","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"乐府","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}