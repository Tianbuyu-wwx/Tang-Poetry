{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_13779","headline":"南归 · 顾况","name":"南归","inLanguage":"zh-Hans","text":"老病力难任，犹多镜雪侵。\n鲈鱼消宦况，鸥鸟识归心。\n急雨江帆重，残更驿树深。\n乡关殊可望，渐渐入吴音。","author":{"@type":"Person","name":"顾况","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_13779.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_13779","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}