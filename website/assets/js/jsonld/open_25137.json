{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_25137","headline":"七夕 · 卢殷","name":"七夕","inLanguage":"zh-Hans","text":"河耿月凉时，牵牛织女期。\n欢娱方在此，漏刻竟由谁。\n定不嫌秋驶，唯当乞夜迟。\n全胜客子媍，十载泣生离。","author":{"@type":"Person","name":"卢殷","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_25137.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_25137","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}