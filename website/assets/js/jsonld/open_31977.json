{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_31977","headline":"题竹谷上人院 · 贾岛","name":"题竹谷上人院","inLanguage":"zh-Hans","text":"禅庭高鸟道，回望极川原。\n樵径连峯顶，石泉通竹根。\n木深犹积雪，山浅未闻猨。\n欲别尘中苦，愿师贻一言。","author":{"@type":"Person","name":"贾岛","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_31977.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_31977","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}