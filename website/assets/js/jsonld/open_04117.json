{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_04117","headline":"阮公体 · 徐晶","name":"阮公体","inLanguage":"zh-Hans","text":"秦王按劒怒，发卒戍龙沙。\n雄图尚未毕，海内已纷拏。\n黄尘暗天起，白日敛精华。\n唯见长城外，僵屍如乱麻。","author":{"@type":"Person","name":"徐晶","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_04117.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_04117","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}