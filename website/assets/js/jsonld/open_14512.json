{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_14512","headline":"送李明府之任 · 戴叔伦","name":"送李明府之任","inLanguage":"zh-Hans","text":"身爲百里长，家宠五诸侯。\n含笑听猨狖，摇鞭望斗牛。\n梅花堪比雪，芳草不知秋。\n别後南风起，相思梦岭头。","author":{"@type":"Person","name":"戴叔伦","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_14512.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_14512","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}