{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_04801","headline":"寄刘道士舃 · 张说","name":"寄刘道士舃","inLanguage":"zh-Hans","text":"真人降紫气，邀我丹田宫。\n远寄双飞舄，飞飞不碍空。","author":{"@type":"Person","name":"张说","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_04801.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_04801","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言绝句","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}