{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_45775","headline":"砚瓦 · 贯休","name":"砚瓦","inLanguage":"zh-Hans","text":"浅薄虽顽朴，其如近笔端。\n低心蒙润久，入匣更身安。\n应念研磨苦，无爲瓦砾看。\n傥然仁不弃，还可比琅玕。","author":{"@type":"Person","name":"贯休","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_45775.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_45775","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}