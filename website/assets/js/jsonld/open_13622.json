{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_13622","headline":"送薛尚书入蜀 · 严维","name":"送薛尚书入蜀","inLanguage":"zh-Hans","text":"卑情不敢论，拜首入辕门。\n列郡诸侯长，登朝八座尊。\n凝笳临水发，行斾向风飜。\n几许遗黎泣，同怀父母恩。","author":{"@type":"Person","name":"严维","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_13622.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_13622","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}