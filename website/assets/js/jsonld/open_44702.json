{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_44702","headline":"谿叟 · 景云","name":"谿叟","inLanguage":"zh-Hans","text":"谿翁居处静，谿鸟入门飞。\n早起钓鱼去，夜深乘月归。\n露香菰米熟，烟煖荇丝肥。\n潇洒尘埃外，扁舟一草衣。","author":{"@type":"Person","name":"景云","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_44702.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_44702","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}