{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_13947","headline":"送绦州郭参军 · 耿湋","name":"送绦州郭参军","inLanguage":"zh-Hans","text":"远事诸侯出，青山古晋城。\n连行麴水阁，独入议中兵。\n夜雨新田湿，春风曙角鸣。\n人传府公政，记室有参卿。","author":{"@type":"Person","name":"耿湋","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_13947.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_13947","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}