{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_27794","headline":"田家 · 欧阳衮","name":"田家","inLanguage":"zh-Hans","text":"黯黯日将夕，牛羊村外来。\n岩阿青气发，篱落杏花开。\n草木应初感，鶬鶊亦已催。\n晚间春作好，行乐不须猜。","author":{"@type":"Person","name":"欧阳衮","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_27794.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_27794","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}