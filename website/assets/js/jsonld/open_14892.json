{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_14892","headline":"秋夜寄冯着作 · 卢纶","name":"秋夜寄冯着作","inLanguage":"zh-Hans","text":"河汉净无云，鸿声此夜闻。\n素心难比石，苍鬓欲如君。\n露槿月中落，风萤池上分。\n何言千载友，同迹不同羣。","author":{"@type":"Person","name":"卢纶","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_14892.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_14892","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}