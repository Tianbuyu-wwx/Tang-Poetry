{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_41209","headline":"公子行 · 黄损","name":"公子行","inLanguage":"zh-Hans","text":"春草绿绵绵，骄骖骤煖烟。\n微风飘乐韵，半日醉花边。\n打鹊抛金盏，招人举玉鞭。\n田翁与蚕妇，平地看神仙。","author":{"@type":"Person","name":"黄损","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_41209.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_41209","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"乐府","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}