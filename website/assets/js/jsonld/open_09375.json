{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_09375","headline":"南园 · 韦应物","name":"南园","inLanguage":"zh-Hans","text":"清露夏天晓，荒园野气通。\n水禽遥泛雪，池莲迥披红。\n幽林讵知暑，环舟似不穷。\n顿洒尘喧意，长啸满襟风。","author":{"@type":"Person","name":"韦应物","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_09375.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_09375","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}