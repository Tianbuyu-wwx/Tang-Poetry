{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_27908","headline":"题蔷薇花 · 朱庆余","name":"题蔷薇花","inLanguage":"zh-Hans","text":"四面垂条密，浮阴入夏清。\n绿攒伤手刺，红堕断肠英。\n粉着蜂须腻，光凝蝶翅明。\n雨中看亦好，况复值初晴。","author":{"@type":"Person","name":"朱庆余","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_27908.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_27908","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}