{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_24891","headline":"享太庙乐章 · 牛僧孺","name":"享太庙乐章","inLanguage":"zh-Hans","text":"湜湜颀颀，融昭德辉。\n不纽不舒，贯成九围。\n武烈文经，敷施当宜。\n纂尧付啓，亿万熙熙。","author":{"@type":"Person","name":"牛僧孺","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_24891.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_24891","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"杂言古诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}