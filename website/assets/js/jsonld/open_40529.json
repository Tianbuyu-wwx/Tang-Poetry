{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_40529","headline":"寄远 · 苏拯","name":"寄远","inLanguage":"zh-Hans","text":"游子虽惜别，一去何时见。\n飞鸟犹恋巢，万里亦何远。\n妾愿化爲霜，日日下河梁。\n若能侵鬓色，先染薄情郎。","author":{"@type":"Person","name":"苏拯","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_40529.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_40529","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}