{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_35412","headline":"昇平词五首 三 · 曹唐","name":"昇平词五首 三","inLanguage":"zh-Hans","text":"处处是欢心，时康岁已深。\n不同三尺劒，应似五弦琴。\n寿笑山犹尽，明嫌日有阴。\n何当怜一物，亦遗断愁吟。","author":{"@type":"Person","name":"曹唐","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_35412.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_35412","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}