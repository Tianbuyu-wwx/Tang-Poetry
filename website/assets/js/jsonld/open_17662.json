{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_17662","headline":"永宁里小园与沈校书接近怅然题寄 · 羊士谔","name":"永宁里小园与沈校书接近怅然题寄","inLanguage":"zh-Hans","text":"故里心期奈别何，手移芳树忆庭柯。\n东臯黍熟君应醉，梨叶初红白露多。","author":{"@type":"Person","name":"羊士谔","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_17662.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_17662","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"七言绝句","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}