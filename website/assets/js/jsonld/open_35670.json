{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_35670","headline":"山下残夏偶作 · 李山甫","name":"山下残夏偶作","inLanguage":"zh-Hans","text":"等闲三伏後，独卧此高丘。\n残暑炎於火，林风爽带秋。\n声名何要出，吟咏亦堪休。\n自许红尘外，云溪好漱流。","author":{"@type":"Person","name":"李山甫","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_35670.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_35670","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}