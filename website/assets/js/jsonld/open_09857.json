{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_09857","headline":"首秋轮台 · 岑参","name":"首秋轮台","inLanguage":"zh-Hans","text":"异域阴山外，孤城雪海边。\n秋来唯有雁，夏尽不闻蝉。\n雨拂氊墙湿，风摇毳幕羶。\n轮台万里地，无事历三年。","author":{"@type":"Person","name":"岑参","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_09857.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_09857","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}