{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_45774","headline":"咏竹根珓子 · 贯休","name":"咏竹根珓子","inLanguage":"zh-Hans","text":"出处慙林薮，才微幸一阳。\n不缘怀片善，岂得近馨香。\n节亦因人净，声从掷地彰。\n但令筋力在，永愿报时昌。","author":{"@type":"Person","name":"贯休","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_45774.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_45774","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}