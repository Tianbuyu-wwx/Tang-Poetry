{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_30681","headline":"远水 · 项斯","name":"远水","inLanguage":"zh-Hans","text":"渺渺浸天色，一边生晚光。\n阔浮萍思远，寒入鴈愁长。\n北极连平地，东流即故乡。\n扁舟来宿处，髣髴似潇湘。","author":{"@type":"Person","name":"项斯","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_30681.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_30681","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}