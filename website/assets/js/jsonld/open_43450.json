{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_43450","headline":"六言诗 · 无名氏","name":"六言诗","inLanguage":"zh-Hans","text":"把酒留君听琴，那堪岁暮离心。\n霜叶无风自落，秋天不雨多阴。\n人愁荒村路远，马怯寒溪水深。","author":{"@type":"Person","name":"无名氏","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_43450.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_43450","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"杂言古诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}