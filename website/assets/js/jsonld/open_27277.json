{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_27277","headline":"刘侍中宅盘花紫蔷薇 · 章孝标","name":"刘侍中宅盘花紫蔷薇","inLanguage":"zh-Hans","text":"真宰偏饶丽景家，当春盘出带根霞。\n从开一朵朝衣色，免踏尘埃看杂花。","author":{"@type":"Person","name":"章孝标","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_27277.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_27277","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"七言绝句","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}