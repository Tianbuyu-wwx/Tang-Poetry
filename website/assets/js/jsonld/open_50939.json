{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_50939","headline":"平原 · 吕从庆","name":"平原","inLanguage":"zh-Hans","text":"碧天连野色，微雨湿蒿藜。\n鸟影松间没，蝉声柳外嘶。\n寺僧张远盖，田父把轻犁。\n逸趣纷纷入，都堪作画题。","author":{"@type":"Person","name":"吕从庆","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_50939.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_50939","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}