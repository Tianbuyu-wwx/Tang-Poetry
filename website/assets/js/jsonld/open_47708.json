{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_47708","headline":"莲叶二客诗 二 · 栾清","name":"莲叶二客诗 二","inLanguage":"zh-Hans","text":"檝櫂无所假，超然信萍查。\n朝浮旭日辉，夕荫清月华。\n营营功业人，朽骨成泥沙。","author":{"@type":"Person","name":"栾清","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_47708.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_47708","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言古诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}