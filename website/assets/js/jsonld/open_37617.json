{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_37617","headline":"茘枝 · 郑谷","name":"茘枝","inLanguage":"zh-Hans","text":"平昔谁相爱，骊山遇贵妃。\n枉教生处远，愁见摘来稀。\n晚夺红霞色，晴欺瘴日威。\n南荒何所恋，爲尔即忘归。","author":{"@type":"Person","name":"郑谷","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_37617.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_37617","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}