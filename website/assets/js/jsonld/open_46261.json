{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_46261","headline":"月夕 · 贯休","name":"月夕","inLanguage":"zh-Hans","text":"霜月夜裴回，楼中羌笛催。\n晓风吹不尽，江上落残梅。","author":{"@type":"Person","name":"贯休","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_46261.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_46261","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言绝句","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry、古籍注评：《御选唐诗》（中文维基文库，CC BY-SA 4.0，https://zh.wikisource.org/wiki/御選唐詩_(四庫全書本)）"}