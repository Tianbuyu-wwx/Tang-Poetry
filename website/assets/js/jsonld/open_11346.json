{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_11346","headline":"所思 · 杜甫","name":"所思","inLanguage":"zh-Hans","text":"郑老身仍窜，台州信所传。\n爲农山涧曲，卧病海云边。\n世已疎儒素，人犹乞酒钱。\n徒劳望牛斗，无计劚龙泉。","author":{"@type":"Person","name":"杜甫","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_11346.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_11346","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}