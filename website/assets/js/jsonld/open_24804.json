{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_24804","headline":"苦雨 · 刘猛","name":"苦雨","inLanguage":"zh-Hans","text":"自念数年间，两手中藏钩。\n於心且无恨，他日爲我羞。\n古老传童歌，连淫亦兵象。\n夜梦戈甲鸣，苦不愿年长。","author":{"@type":"Person","name":"刘猛","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_24804.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_24804","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}