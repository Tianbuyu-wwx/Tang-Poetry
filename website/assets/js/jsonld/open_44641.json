{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_44641","headline":"诗 二十七 · 拾得","name":"诗 二十七","inLanguage":"zh-Hans","text":"闭门私造罪，准拟免灾殃。\n被他恶部童，抄得报阎王。\n纵不入镬汤，亦须卧铁牀。\n不许雇人替，自作自身当。","author":{"@type":"Person","name":"拾得","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_44641.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_44641","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}