{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_29933","headline":"送陈明府之任 · 潘咸","name":"送陈明府之任","inLanguage":"zh-Hans","text":"客见天台县，闾阎树色间。\n骖回几临水，带缓独开山。\n吏散落花尽，人居远岛闲。\n过於老莱子，端简独承颜。","author":{"@type":"Person","name":"潘咸","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_29933.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_29933","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}