{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_10572","headline":"同孟浩然宴赋 · 王迥","name":"同孟浩然宴赋","inLanguage":"zh-Hans","text":"屈宋英声今止已，江山继嗣多才子。\n作者于今尽相似，聚宴王家其乐矣。\n共赋新诗发宫徵，书于屋壁彰厥美。","author":{"@type":"Person","name":"王迥","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_10572.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_10572","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"七言古诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}