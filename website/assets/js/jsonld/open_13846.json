{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_13846","headline":"溪上 · 顾况","name":"溪上","inLanguage":"zh-Hans","text":"采莲溪上女，舟小怯摇风。\n惊起鸳鸯宿，水云撩乱红。","author":{"@type":"Person","name":"顾况","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_13846.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_13846","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言绝句","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry、古籍注评：《唐诗镜》（中文维基文库，CC BY-SA 4.0，https://zh.wikisource.org/wiki/唐詩鏡_(四庫全書本)）"}