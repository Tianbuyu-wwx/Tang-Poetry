{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_42497","headline":"寒夜吟 · 成彦雄","name":"寒夜吟","inLanguage":"zh-Hans","text":"洞房脉脉寒宵永，烛影香消金凤冷。\n猧儿睡魇唤不醒，满窗扑落银蟾影。","author":{"@type":"Person","name":"成彦雄","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_42497.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_42497","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"乐府","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}