{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_20178","headline":"姑蔑城 · 孟郊","name":"姑蔑城","inLanguage":"zh-Hans","text":"劲越既成土，强吴亦爲墟。\n皇风一已被，兹邑信平居。\n抚俗观旧迹，行春布新书。\n兴亡意何在，绵叹空踌蹰。","author":{"@type":"Person","name":"孟郊","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_20178.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_20178","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}