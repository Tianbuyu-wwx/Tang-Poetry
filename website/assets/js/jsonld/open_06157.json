{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_06157","headline":"别辋川别业 · 王维","name":"别辋川别业","inLanguage":"zh-Hans","text":"依迟动车马，惆怅出松萝。\n忍别青山去，其如绿水何。","author":{"@type":"Person","name":"王维","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_06157.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_06157","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言绝句","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry、古籍注评：《御选唐诗》（中文维基文库，CC BY-SA 4.0，https://zh.wikisource.org/wiki/御選唐詩_(四庫全書本)）"}