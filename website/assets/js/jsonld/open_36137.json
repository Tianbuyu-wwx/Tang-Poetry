{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_36137","headline":"山中 · 方干","name":"山中","inLanguage":"zh-Hans","text":"散拙亦自遂，麤将猨鸟同。\n飞泉高泻月，独树逈含风。\n果落盘盂上，云生箧笥中。\n未甘明圣日，终作钓渔翁。","author":{"@type":"Person","name":"方干","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_36137.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_36137","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}