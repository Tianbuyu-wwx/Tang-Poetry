{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_45322","headline":"效古 · 皎然","name":"效古","inLanguage":"zh-Hans","text":"思君转战度交河，强弄胡琴不成曲。\n日落应愁陇底难，春来定梦江南数。\n万丈游丝是妾心，惹蝶萦花乱相续。","author":{"@type":"Person","name":"皎然","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_45322.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_45322","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"七言古诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}