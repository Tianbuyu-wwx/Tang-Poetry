{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_35317","headline":"题湖上友人居 · 张乔","name":"题湖上友人居","inLanguage":"zh-Hans","text":"岂得恋樵渔，全家湖畔居。\n远无潮客信，闲寄岳僧书。\n野白梅繁後，山明雨散初。\n逍遥向云水，莫与宦情疎。","author":{"@type":"Person","name":"张乔","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_35317.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_35317","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}