{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_40068","headline":"烟 · 徐夤","name":"烟","inLanguage":"zh-Hans","text":"燎野焚林见所从，惹空横水展形容。\n能滋甘雨随车润，不并行云逐梦踪。\n晴鸟回笼嘉树薄，春亭娇幕好花浓。\n有时片片风吹去，海碧山清过几重。","author":{"@type":"Person","name":"徐夤","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_40068.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_40068","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"七言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}