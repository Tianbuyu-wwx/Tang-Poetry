{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_27081","headline":"缑氏韦明府厅 · 周贺","name":"缑氏韦明府厅","inLanguage":"zh-Hans","text":"贵邑清风满，谁同上宰心。\n杉松出郭外，雨电下嵩阴。\n度鴈方离垒，来僧始别岑。\n西池月才迥，会接一宵吟。","author":{"@type":"Person","name":"周贺","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_27081.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_27081","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}