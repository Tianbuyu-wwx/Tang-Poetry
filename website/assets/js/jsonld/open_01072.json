{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_01072","headline":"相和歌辞 陌上桑 · 陆龟蒙","name":"相和歌辞 陌上桑","inLanguage":"zh-Hans","text":"皓齿还如贝色含，长眉亦似烟华贴。\n邻娃尽着绣裆襦，独自提筐采蚕叶。","author":{"@type":"Person","name":"陆龟蒙","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_01072.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_01072","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"乐府","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}