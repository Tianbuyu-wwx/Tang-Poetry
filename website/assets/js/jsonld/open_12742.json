{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_12742","headline":"奉寄皇甫补阙 · 张继","name":"奉寄皇甫补阙","inLanguage":"zh-Hans","text":"京口情人别久，扬州估客来疎。\n潮至浔阳回去，相思无处通书。","author":{"@type":"Person","name":"张继","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_12742.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_12742","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"杂言古诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}