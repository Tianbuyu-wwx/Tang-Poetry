{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_31007","headline":"题逃户 · 薛能","name":"题逃户","inLanguage":"zh-Hans","text":"几世瞢农桑，凶年竟失乡。\n朽关生湿菌，倾屋照斜阳。\n雨水淹残臼，葵花压倒墙。\n明时岂致此，应自负苍苍。","author":{"@type":"Person","name":"薛能","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_31007.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_31007","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}