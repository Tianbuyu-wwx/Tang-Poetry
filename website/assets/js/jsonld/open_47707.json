{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_47707","headline":"莲叶二客诗 一 · 栾清","name":"莲叶二客诗 一","inLanguage":"zh-Hans","text":"行时云作伴，坐即酒爲侣。\n腹以元化充，衣将云霞补。\n纣虐与尧仁，可惜皆朽腐。","author":{"@type":"Person","name":"栾清","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_47707.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_47707","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言古诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}