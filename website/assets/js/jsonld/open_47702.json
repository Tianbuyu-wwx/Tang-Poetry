{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_47702","headline":"兜玄国怀归诗 · 申欢","name":"兜玄国怀归诗","inLanguage":"zh-Hans","text":"风软景和煦，异香馥林塘。\n登高一长望，信美非吾乡。","author":{"@type":"Person","name":"申欢","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_47702.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_47702","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言绝句","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}