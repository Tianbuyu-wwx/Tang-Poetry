{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_38252","headline":"昼寝 · 韩偓","name":"昼寝","inLanguage":"zh-Hans","text":"碧桐阴尽隔帘栊，扇拂金鹅玉簟烘。\n扑粉更添香体滑，解衣唯见下裳红。\n烦襟乍触冰壶冷，倦枕徐敧宝髻松。\n何必苦劳魂与梦，王昌只在此墙东。","author":{"@type":"Person","name":"韩偓","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_38252.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_38252","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"七言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}