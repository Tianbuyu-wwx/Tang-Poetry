{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_26833","headline":"苦雨 · 姚合","name":"苦雨","inLanguage":"zh-Hans","text":"江昏山半晴，南阻绝人行。\n葭菼连云色，松杉共雨声。\n早秋仍燕舞，深夜更鼍鸣。\n爲报迷津客，讹言未可轻。","author":{"@type":"Person","name":"姚合","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_26833.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_26833","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}