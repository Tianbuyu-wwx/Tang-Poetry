{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_33668","headline":"穷冬太学 · 林宽","name":"穷冬太学","inLanguage":"zh-Hans","text":"投迹依槐馆，荒亭草合时。\n雪深鸢啸急，薪湿鼎吟迟。\n默坐同谁话，非僧不我知。\n匡庐瀑布畔，何日副心期。","author":{"@type":"Person","name":"林宽","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_33668.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_33668","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}