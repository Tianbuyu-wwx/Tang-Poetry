{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_47777","headline":"又吟 · 酒肆布衣","name":"又吟","inLanguage":"zh-Hans","text":"有形皆朽孰不知，休吟春景与秋时。\n争如且醉长安酒，荣华零悴总奚爲。","author":{"@type":"Person","name":"酒肆布衣","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_47777.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_47777","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"乐府","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}