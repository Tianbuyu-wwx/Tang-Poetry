{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_37913","headline":"灞上 · 崔涂","name":"灞上","inLanguage":"zh-Hans","text":"长安名利路，役役古田今。\n征骑少闲日，绿杨无旧阴。\n水侵秦甸阔，草接汉陵深。\n紫阁曾过处，依稀白鸟沈。","author":{"@type":"Person","name":"崔涂","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_37913.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_37913","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}