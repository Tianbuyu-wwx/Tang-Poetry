{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_39468","headline":"句 · 王贞白","name":"句","inLanguage":"zh-Hans","text":"太阳虽不照，梁栋每重阴。\n白发未逢媒，对景且裴回。\n别酒莫辞今夜醉，故人知我几时来。\n改贯永留乡党额，减租重感郡侯恩。","author":{"@type":"Person","name":"王贞白","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_39468.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_39468","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"杂言古诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}