{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_09349","headline":"游溪 · 韦应物","name":"游溪","inLanguage":"zh-Hans","text":"野水烟鹤唳，楚天云雨空。\n翫舟清景晚，垂钓绿蒲中。\n落花飘旅衣，归流澹清风。\n缘源不可极，远树但青葱。","author":{"@type":"Person","name":"韦应物","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_09349.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_09349","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}