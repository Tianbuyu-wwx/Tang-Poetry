{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_30328","headline":"江边 · 赵嘏","name":"江边","inLanguage":"zh-Hans","text":"终日劳车马，江边款竹扉。\n残花春浪阔，小酒故人稀。\n戍鼓客帆远，津云夕照微。\n何由兄与弟，俱及暮春归。","author":{"@type":"Person","name":"赵嘏","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_30328.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_30328","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}