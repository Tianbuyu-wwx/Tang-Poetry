{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_39244","headline":"山墅闲题 · 韦庄","name":"山墅闲题","inLanguage":"zh-Hans","text":"逦迤前冈压後冈，一川桑柘好残阳。\n主人馈饷炊红黍，邻父携竿钓紫鲂。\n静极却嫌流水闹，闲多翻笑野云忙。\n有名不那无名客，独闭衡门避建康。","author":{"@type":"Person","name":"韦庄","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_39244.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_39244","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"七言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}