{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_13199","headline":"送薛秀才 · 皇甫冉","name":"送薛秀才","inLanguage":"zh-Hans","text":"虽是寻山客，还同慢世人。\n读书惟务静，无褐不忧贫。\n野色春冬树，鸡声远近邻。\n郄公即吾友，合与尔相亲。","author":{"@type":"Person","name":"皇甫冉","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_13199.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_13199","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}