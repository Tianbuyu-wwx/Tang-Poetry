{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_39846","headline":"赠严司直 · 徐夤","name":"赠严司直","inLanguage":"zh-Hans","text":"承家居阙下，避世出关东。\n有酒刘伶醉，无儿伯道穷。\n新诗吟阁赏，旧业钓台空。\n雨雪还相访，心怀与我同。","author":{"@type":"Person","name":"徐夤","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_39846.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_39846","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}