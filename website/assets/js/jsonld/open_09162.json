{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_09162","headline":"送中弟 · 韦应物","name":"送中弟","inLanguage":"zh-Hans","text":"秋风入疎户，离人起晨朝。\n山郡多风雨，西楼更萧条。\n嗟予淮海老，送子关河遥。\n同来不同去，沈忧宁复消。","author":{"@type":"Person","name":"韦应物","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_09162.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_09162","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}