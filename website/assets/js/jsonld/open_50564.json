{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_50564","headline":"咏鸭头铛子 · 张鷟","name":"咏鸭头铛子","inLanguage":"zh-Hans","text":"觜长非爲嗍，项曲不由攀。\n但令脚直上，他自眼双翻。","author":{"@type":"Person","name":"张鷟","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_50564.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_50564","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言绝句","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}