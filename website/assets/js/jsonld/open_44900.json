{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_44900","headline":"官池上 · 无可","name":"官池上","inLanguage":"zh-Hans","text":"迥疏城阙内，寒泻出云波。\n岸广山鱼到，汀闲海鹭过。\n泛沟侵道急，流叶入宫多。\n移舸浮中沚，清宵彻晓河。","author":{"@type":"Person","name":"无可","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_44900.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_44900","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}