{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_04006","headline":"晦日宴高氏林亭 · 周彦晖","name":"晦日宴高氏林亭","inLanguage":"zh-Hans","text":"砌蓂收晦魄，津柳竞年华。\n既狎忘筌友，方淹投辖车。\n绮筵回舞雪，琼醑泛流霞。\n云低上天晚，丝雨带风斜。","author":{"@type":"Person","name":"周彦晖","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_04006.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_04006","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}