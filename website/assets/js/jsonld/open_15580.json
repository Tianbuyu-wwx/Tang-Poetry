{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_15580","headline":"春情 · 杨凝","name":"春情","inLanguage":"zh-Hans","text":"旧宅洛川阳，曾游游侠场。\n水添杨柳色，花绊绮罗香。\n赵瑟多愁曲，秦家足艳妆。\n江潭远相忆，春梦不胜长。","author":{"@type":"Person","name":"杨凝","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_15580.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_15580","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}