{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_10180","headline":"登秦岭 · 李嘉佑","name":"登秦岭","inLanguage":"zh-Hans","text":"南登秦岭头，回望始堪愁。\n汉阙青门远，高山蓝水流。\n三湘迁客去，九陌故人游。\n从此辞乡泪，双垂不复收。","author":{"@type":"Person","name":"李嘉佑","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_10180.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_10180","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}