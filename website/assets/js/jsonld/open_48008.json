{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_48008","headline":"唐晅悼妻诗 一 · 唐晅妻张氏","name":"唐晅悼妻诗 一","inLanguage":"zh-Hans","text":"寝室悲长簟，妆楼泣镜台。\n独悲桃李节，不共夜泉开。\n魂兮若有感，髣髴梦中来。","author":{"@type":"Person","name":"唐晅妻张氏","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_48008.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_48008","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言古诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}