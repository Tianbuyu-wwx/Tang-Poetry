{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_00303","headline":"黄台瓜辞 · 章怀太子","name":"黄台瓜辞","inLanguage":"zh-Hans","text":"种瓜黄台下，瓜熟子离离。\n一摘使瓜好，再摘使瓜稀。\n三摘犹自可，摘绝抱蔓归。","author":{"@type":"Person","name":"章怀太子","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_00303.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_00303","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"乐府","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}