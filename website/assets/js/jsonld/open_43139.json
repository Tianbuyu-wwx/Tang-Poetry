{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_43139","headline":"杨岐山 · 刘廓","name":"杨岐山","inLanguage":"zh-Hans","text":"千峰围古寺，深处敞楼台。\n景异寻常处，人须特达来。\n松杉寒更茂，岚霭昼还开。\n欲续丰碑语，含毫恨不才。","author":{"@type":"Person","name":"刘廓","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_43139.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_43139","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}