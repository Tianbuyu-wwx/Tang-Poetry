{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_39475","headline":"送成州牧 · 张蠙","name":"送成州牧","inLanguage":"zh-Hans","text":"清时爲塞郡，自古有儒流。\n素望知难惬，新恩且用酬。\n犬牙连蜀国，兵额贯秦州。\n秪作三年别，谁能听邑留。","author":{"@type":"Person","name":"张蠙","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_39475.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_39475","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}