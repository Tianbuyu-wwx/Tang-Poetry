{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_25047","headline":"题十三弟竹园 · 刘言史","name":"题十三弟竹园","inLanguage":"zh-Hans","text":"绕屋扶疎耸翠茎，苔滋粉漾有幽情。\n丹阳万户春光静，独自君家秋雨声。","author":{"@type":"Person","name":"刘言史","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_25047.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_25047","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"七言绝句","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}