{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_13975","headline":"渭上送李蔵器移家东都 · 耿湋","name":"渭上送李蔵器移家东都","inLanguage":"zh-Hans","text":"求名虽有据，学稼又无田。\n故国三千里，新春五十年。\n移家还作客，避地莫知贤。\n洛浦今何处，风帆去渺然。","author":{"@type":"Person","name":"耿湋","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_13975.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_13975","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}