{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_45763","headline":"渔父 · 贯休","name":"渔父","inLanguage":"zh-Hans","text":"一叶一竿竹，眉须雪欲零。\n陆应无祖业，香必是伊腥。\n儿亦名鱼鹧，歌称我洞庭。\n回头深自媿，旧业近沧溟。","author":{"@type":"Person","name":"贯休","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_45763.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_45763","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}