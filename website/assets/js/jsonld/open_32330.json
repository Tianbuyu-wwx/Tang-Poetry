{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_32330","headline":"偶题 · 温庭筠","name":"偶题","inLanguage":"zh-Hans","text":"孔雀眠高阁，樱桃拂短檐。\n画明金冉冉，筝语玉纤纤。\n细雨无妨烛，轻寒不隔帘。\n欲将红锦段，因梦寄江淹。","author":{"@type":"Person","name":"温庭筠","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_32330.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_32330","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}