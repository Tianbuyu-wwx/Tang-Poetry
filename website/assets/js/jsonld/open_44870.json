{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_44870","headline":"陨叶 · 无可","name":"陨叶","inLanguage":"zh-Hans","text":"遶巷夹溪红，萧条逐北风。\n别林遗宿鸟，浮水载鸣虫。\n石小埋初尽，枝长落未终。\n带霜书丽什，闲读白云中。","author":{"@type":"Person","name":"无可","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_44870.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_44870","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}