{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_42922","headline":"题柳 · 狄焕","name":"题柳","inLanguage":"zh-Hans","text":"天南与天北，此处影婆娑。\n翠色折不尽，离情生更多。\n雨余笼灞岸，烟暝夹隋河。\n自有佳名在，秦松继得麽。","author":{"@type":"Person","name":"狄焕","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_42922.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_42922","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}