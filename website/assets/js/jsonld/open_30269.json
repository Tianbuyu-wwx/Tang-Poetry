{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_30269","headline":"狼烟 · 薛逢","name":"狼烟","inLanguage":"zh-Hans","text":"三道狼烟过碛来，受降城上探旗开。\n传声却报边无事，自是官军入抄回。","author":{"@type":"Person","name":"薛逢","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_30269.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_30269","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"七言绝句","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}