{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_15374","headline":"送诸曁裴少府 · 李端","name":"送诸曁裴少府","inLanguage":"zh-Hans","text":"山公访嵇绍，赵武见韩侯。\n事去恩犹在，名成泪却流。\n一官同北去，千里赴南州。\n才子清风後，无贻相府忧。","author":{"@type":"Person","name":"李端","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_15374.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_15374","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}