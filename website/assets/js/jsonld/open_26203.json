{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_26203","headline":"署中答武功姚合 · 殷尧藩","name":"署中答武功姚合","inLanguage":"zh-Hans","text":"原中多阴雨，惟留一室明。\n自宜居静者，谁得问先生。\n深井泉香出，危沙药更荣。\n全家笑无辱，曾不见戈兵。","author":{"@type":"Person","name":"殷尧藩","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_26203.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_26203","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}