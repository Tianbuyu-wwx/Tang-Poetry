{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_25763","headline":"上令狐舍人 · 李廓","name":"上令狐舍人","inLanguage":"zh-Hans","text":"名利生愁地，贫居岁月移。\n买书添架上，断酒过花时。\n宿客嫌吟苦，乖童恨睡迟。\n近来唯俭静，持此荅深知。","author":{"@type":"Person","name":"李廓","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_25763.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_25763","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}