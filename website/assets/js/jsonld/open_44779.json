{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_44779","headline":"杂诗 五 · 庞藴","name":"杂诗 五","inLanguage":"zh-Hans","text":"日用事无别，惟吾自偶偕。\n头头非取舍，处处勿张乖。\n朱紫谁爲号，青山绝点埃。\n神通幷妙用，运水及搬柴。","author":{"@type":"Person","name":"庞藴","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_44779.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_44779","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}