{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_35772","headline":"途中作 · 李咸用","name":"途中作","inLanguage":"zh-Hans","text":"瘦马倦行役，斜阳劝着鞭。\n野桥寒树亚，山店暮云连。\n退鷁风虽急，攀龙志已坚。\n路人休莫笑，百里有时贤。","author":{"@type":"Person","name":"李咸用","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_35772.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_35772","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}