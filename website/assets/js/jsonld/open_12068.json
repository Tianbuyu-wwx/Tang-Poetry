{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_12068","headline":"初至巴陵与李十二白裴九同泛洞庭湖三首 三 · 贾至","name":"初至巴陵与李十二白裴九同泛洞庭湖三首 三","inLanguage":"zh-Hans","text":"江畔枫叶初带霜，渚边菊花亦已黄。\n轻舟落日兴不尽，三湘五湖意何长。","author":{"@type":"Person","name":"贾至","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_12068.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_12068","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"七言绝句","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}