{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_27115","headline":"春日重至南徐旧居 · 周贺","name":"春日重至南徐旧居","inLanguage":"zh-Hans","text":"绿水阴空院，春深喜再来。\n独眠从草长，留酒看花开。\n过雨远山出，向风孤鸟回。\n忽思秋夕事，云物却悠哉。","author":{"@type":"Person","name":"周贺","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_27115.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_27115","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}