{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_57102","headline":"独自诗二十章 九 · 傅翕","name":"独自诗二十章 九","inLanguage":"zh-Hans","text":"独自归，登山度岭何所依。\n比至所依无定实，熟观此境竟何为。","author":{"@type":"Person","name":"傅翕","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_57102.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_57102","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"古风","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}