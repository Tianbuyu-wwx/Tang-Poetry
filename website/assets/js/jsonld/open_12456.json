{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_12456","headline":"题张蓝田讼堂 · 钱起","name":"题张蓝田讼堂","inLanguage":"zh-Hans","text":"角巾高枕向晴山，讼简庭空不用关。\n秋风窗下琴书静，夜景门前人吏闲。\n稍觉渊明归思远，东臯月出片云还。","author":{"@type":"Person","name":"钱起","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_12456.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_12456","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"七言古诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}