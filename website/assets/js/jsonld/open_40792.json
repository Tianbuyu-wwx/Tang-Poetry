{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_40792","headline":"赠楚公 · 唐求","name":"赠楚公","inLanguage":"zh-Hans","text":"曾闻半偈雪山中，贝叶飜时理尽通。\n般若恒添持戒力，落叉谁算念经功。\n云间晓月应难染，海上虚舟自信风。\n长说满庭花色好，一枝红是一枝空。","author":{"@type":"Person","name":"唐求","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_40792.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_40792","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"七言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}