{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_39259","headline":"稻田 · 韦庄","name":"稻田","inLanguage":"zh-Hans","text":"绿波春浪满前陂，极目连云䆉稏肥。\n更被鹭鷀千点雪，破烟来入画屏飞。","author":{"@type":"Person","name":"韦庄","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_39259.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_39259","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"七言绝句","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry、古籍注评：《御选唐诗》（中文维基文库，CC BY-SA 4.0，https://zh.wikisource.org/wiki/御選唐詩_(四庫全書本)）"}