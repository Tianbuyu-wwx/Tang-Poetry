{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_37578","headline":"哭建州李员外频 · 郑谷","name":"哭建州李员外频","inLanguage":"zh-Hans","text":"令终归故里，末岁道如初。\n旧友谁爲志，清风岂易书。\n雨坟生野蕨，乡奠钓江鱼。\n独夜吟还泣，前年伴直庐。","author":{"@type":"Person","name":"郑谷","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_37578.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_37578","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}