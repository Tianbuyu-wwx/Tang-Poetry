{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_17617","headline":"书楼怀古 · 羊士谔","name":"书楼怀古","inLanguage":"zh-Hans","text":"何独文翁化，风流与代深。\n泉云无旧辙，骚雅有遗音。\n远目穷巴汉，闲情阅古今。\n忘言意不极，日暮但横琴。","author":{"@type":"Person","name":"羊士谔","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_17617.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_17617","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}