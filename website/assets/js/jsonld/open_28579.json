{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_28579","headline":"夜雨 · 杜牧","name":"夜雨","inLanguage":"zh-Hans","text":"九月三十日，雨声如别秋。\n无端满阶叶，共白几人头。\n点滴侵寒梦，萧骚着淡愁。\n渔歌听不唱，蓑湿棹回舟。","author":{"@type":"Person","name":"杜牧","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_28579.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_28579","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}