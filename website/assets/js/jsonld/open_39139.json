{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_39139","headline":"宿山家 · 韦庄","name":"宿山家","inLanguage":"zh-Hans","text":"山行侵夜到，云窦一星灯。\n草动蛇寻穴，枝摇鼠上藤。\n背风开药竈，向月展渔罾。\n明日前溪路，烟萝更几层。","author":{"@type":"Person","name":"韦庄","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_39139.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_39139","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}