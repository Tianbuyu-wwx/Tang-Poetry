{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_21530","headline":"酬乐天秋兴见赠本句云莫怪独吟秋兴苦比君校近二毛年 · 元稹","name":"酬乐天秋兴见赠本句云莫怪独吟秋兴苦比君校近二毛年","inLanguage":"zh-Hans","text":"劝君休作悲秋赋，白发如星也任垂。\n毕竟百年同是梦，长年何异少何爲。","author":{"@type":"Person","name":"元稹","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_21530.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_21530","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"乐府","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}