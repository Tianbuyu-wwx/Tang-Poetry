{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_00327","headline":"悼诗 · 後主煜","name":"悼诗","inLanguage":"zh-Hans","text":"永念难消释，孤怀痛自嗟。\n雨深秋寂莫，愁引病增加。\n咽绝风前思，昏蒙眼上花。\n空王应念我，穷子正迷家。","author":{"@type":"Person","name":"後主煜","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_00327.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_00327","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}