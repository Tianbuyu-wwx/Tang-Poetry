{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_07040","headline":"对酒寄严维 · 刘长卿","name":"对酒寄严维","inLanguage":"zh-Hans","text":"陋巷喜阳和，衰颜对酒歌。\n嬾从华发乱，闲任白云多。\n郡简容垂钓，家贫学弄梭。\n门前七里濑，早晚子陵过。","author":{"@type":"Person","name":"刘长卿","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_07040.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_07040","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}