{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_01557","headline":"琴曲歌辞  渌水辞 · 李贺","name":"琴曲歌辞  渌水辞","inLanguage":"zh-Hans","text":"今宵好风月，阿侯在何处？\n爲有倾城色，翻成足愁苦。\n东湖采莲叶，南湖拔蒲根。\n未持寄小姑，且持感愁魂。","author":{"@type":"Person","name":"李贺","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_01557.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_01557","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"乐府","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}