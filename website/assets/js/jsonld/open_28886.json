{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_28886","headline":"晨别翛然上人 · 许浑","name":"晨别翛然上人","inLanguage":"zh-Hans","text":"吴僧诵经罢，败衲倚蒲团。\n钟韵花犹歛，楼阴月向残。\n晴山开殿响，秋水卷帘寒。\n独恨孤舟去，千滩复万滩。","author":{"@type":"Person","name":"许浑","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_28886.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_28886","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}