{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_09048","headline":"雪夜下朝呈省中一绝 · 韦应物","name":"雪夜下朝呈省中一绝","inLanguage":"zh-Hans","text":"南望青山满禁闱，晓陪鸳鹭正差池。\n共爱朝来何处雪，蓬莱宫里拂松枝。","author":{"@type":"Person","name":"韦应物","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_09048.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_09048","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"七言绝句","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}