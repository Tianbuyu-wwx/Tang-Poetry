{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_40614","headline":"维摩畅林居 · 李洞","name":"维摩畅林居","inLanguage":"zh-Hans","text":"诸方游几腊，五夏五峰销。\n越讲迎骑象，蕃斋忏射鵰。\n冷筇和雪倚，朽栎带云烧。\n从此西林老，瞥然三万朝。","author":{"@type":"Person","name":"李洞","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_40614.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_40614","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}