{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_09860","headline":"还东山洛上作 · 岑参","name":"还东山洛上作","inLanguage":"zh-Hans","text":"春流急不浅，归栧去何迟。\n愁客叶舟里，夕阳花水时。\n云晴开螮蝀，櫂发起鸬鷀。\n莫道东山远，衡门在梦思。","author":{"@type":"Person","name":"岑参","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_09860.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_09860","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}