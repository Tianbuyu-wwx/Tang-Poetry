{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_19541","headline":"吴兴三绝 · 张文规","name":"吴兴三绝","inLanguage":"zh-Hans","text":"苹洲须觉池沼俗，苎布直胜罗纨轻。\n清风楼下草初出，明月峡中茶始生。\n吴兴三绝不可舍，劝子强爲吴会行。","author":{"@type":"Person","name":"张文规","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_19541.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_19541","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"七言古诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}