{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_04711","headline":"右侍郎集贤院学士徐公挽词二首 一 · 张说","name":"右侍郎集贤院学士徐公挽词二首 一","inLanguage":"zh-Hans","text":"才美临淄北，名高淮海东。\n羽仪三省遍，渔猎五车通。\n玉殿孤新榜，珠英落旧丛。","author":{"@type":"Person","name":"张说","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_04711.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_04711","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言古诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}