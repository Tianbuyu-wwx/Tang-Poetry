{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_29720","headline":"访秋 · 李商隐","name":"访秋","inLanguage":"zh-Hans","text":"酒薄吹还醒，楼危望已穷。\n江臯当落日，帆席见归风。\n烟带龙潭白，霞分鸟道红。\n殷勤报秋意，只是有丹枫。","author":{"@type":"Person","name":"李商隐","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_29720.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_29720","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}