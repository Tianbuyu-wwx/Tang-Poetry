{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_40810","headline":"秋夕闻雁 · 于邺","name":"秋夕闻雁","inLanguage":"zh-Hans","text":"星汉欲沈尽，谁家砧未休。\n忽闻梁雁至，如报杜陵秋。\n千树又黄叶，几人新白头。\n洞庭今夜客，一半却登舟。","author":{"@type":"Person","name":"于邺","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_40810.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_40810","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}