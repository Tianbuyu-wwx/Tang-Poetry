{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_13480","headline":"寒食戏赠 · 柳中庸","name":"寒食戏赠","inLanguage":"zh-Hans","text":"春暮越江边，春阴寒食天。\n杏花香麦粥，柳絮伴秋千。\n酒是芳菲节，人当桃李年。\n不知何处恨，已解入筝弦。","author":{"@type":"Person","name":"柳中庸","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_13480.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_13480","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}