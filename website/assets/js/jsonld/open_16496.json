{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_16496","headline":"行营送人 · 刘商","name":"行营送人","inLanguage":"zh-Hans","text":"鞞鼓喧喧对古城，独寻归鸟马蹄轻。\n回来看觅莺飞处，即是将军细柳营。","author":{"@type":"Person","name":"刘商","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_16496.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_16496","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"乐府","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}