{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_03842","headline":"咏雾 · 苏味道","name":"咏雾","inLanguage":"zh-Hans","text":"氤氲起洞壑，遥裔匝平畴。\n乍似含龙劒，还疑映蜃楼。\n拂林随雨密，度径带烟浮。\n方谢公超步，终从彦辅游。","author":{"@type":"Person","name":"苏味道","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_03842.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_03842","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}