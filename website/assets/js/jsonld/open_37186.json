{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_37186","headline":"春鸠 · 温宪","name":"春鸠","inLanguage":"zh-Hans","text":"村南微雨新，平绿净无尘。\n散睡桑条暖，闲鸣屋脊春。\n远闻和晓梦，相应在诸邻。\n行乐花时节，追飞见亦频。","author":{"@type":"Person","name":"温宪","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_37186.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_37186","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}