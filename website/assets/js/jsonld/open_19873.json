{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_19873","headline":"夜忧 · 孟郊","name":"夜忧","inLanguage":"zh-Hans","text":"岂独科斗死，所嗟文字捐。\n蒿蔓转骄弄，菱荇减婵娟。\n未遂摆鳞志，空思吹浪旋。\n何当再霖雨，洗濯生华鲜。","author":{"@type":"Person","name":"孟郊","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_19873.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_19873","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}