{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_17819","headline":"名姝咏 · 杨巨源","name":"名姝咏","inLanguage":"zh-Hans","text":"阿娇年未多，体弱性能和。\n怕重愁拈镜，怜轻喜曳罗。\n临津双洛浦，对月两嫦娥。\n独有荆王殿，时时暮雨过。","author":{"@type":"Person","name":"杨巨源","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_17819.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_17819","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}