{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_22342","headline":"秋日 · 白居易","name":"秋日","inLanguage":"zh-Hans","text":"池残寥落水，窗下悠杨日。\n嫋嫋秋风多，槐花半成实。\n下有独立人，年来四十一。","author":{"@type":"Person","name":"白居易","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_22342.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_22342","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言古诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}