{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_44644","headline":"诗 三十 · 拾得","name":"诗 三十","inLanguage":"zh-Hans","text":"少年学书劒，叱驭到荆州。\n闻伐匈奴尽，婆娑无处游。\n归来翠岩下，席草翫清流。\n壮士志未骋，猕猴骑土牛。","author":{"@type":"Person","name":"拾得","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_44644.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_44644","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}