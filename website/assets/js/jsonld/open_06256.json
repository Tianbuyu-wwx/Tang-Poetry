{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_06256","headline":"竹下残雪 · 丘爲","name":"竹下残雪","inLanguage":"zh-Hans","text":"一点消未尽，孤月在竹阴。\n晴光夜转莹，寒气晓仍深。\n还对读书牖，且关乘兴心。\n已能依此地，终不傍瑶琴。","author":{"@type":"Person","name":"丘爲","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_06256.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_06256","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}