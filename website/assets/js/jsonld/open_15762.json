{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_15762","headline":"田家 · 司空曙","name":"田家","inLanguage":"zh-Hans","text":"田家喜雨足，邻老相招携。\n泉溢沟塍坏，麦高桑柘低。\n呼儿催放犊，宿客待烹鸡。\n搔首蓬门下，如将轩冕齐。","author":{"@type":"Person","name":"司空曙","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_15762.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_15762","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}