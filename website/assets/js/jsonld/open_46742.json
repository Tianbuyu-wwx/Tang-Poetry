{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_46742","headline":"寄旧居隣友 · 齐己","name":"寄旧居隣友","inLanguage":"zh-Hans","text":"别後知何趣，搜奇少客同。\n几层山影下，万树雪声中。\n晚鼎烹茶绿，晨厨爨粟红。\n何时携卷出，世代有名公。","author":{"@type":"Person","name":"齐己","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_46742.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_46742","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}