{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_14001","headline":"秋夜喜卢司直严少府访宿 · 耿湋","name":"秋夜喜卢司直严少府访宿","inLanguage":"zh-Hans","text":"寂寂闭层城，悠悠此夜情。\n早凉过鬓发，秋思入柴荆。\n严子多高趣，卢公有盛名。\n还如杜陵下，暂拂蒋元卿。","author":{"@type":"Person","name":"耿湋","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_14001.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_14001","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}