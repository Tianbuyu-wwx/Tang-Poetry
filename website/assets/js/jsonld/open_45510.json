{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_45510","headline":"观碁 · 子兰","name":"观碁","inLanguage":"zh-Hans","text":"拂局尽消时，能因长路迟。\n点头初得计，格手待无疑。\n寂默亲遗景，凝神入过思。\n共藏多少意，不语两相知。","author":{"@type":"Person","name":"子兰","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_45510.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_45510","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}