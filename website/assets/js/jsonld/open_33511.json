{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_33511","headline":"投徐端公 · 许棠","name":"投徐端公","inLanguage":"zh-Hans","text":"无谋寻旧友，强喜亦如愁。\n丹桂阻丹恳，白衣成白头。\n穷吴迷钓业，大漠事贫游。\n霄汉期提引，龙锺未拟休。","author":{"@type":"Person","name":"许棠","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_33511.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_33511","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}