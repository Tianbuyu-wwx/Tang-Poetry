{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_04195","headline":"送费六还蜀 · 骆宾王","name":"送费六还蜀","inLanguage":"zh-Hans","text":"星楼望蜀道，月峡指吴门。\n万行流别泪，九折切惊魂。\n雪影含花落，云阴带叶昏。\n还愁三径晚，独对一清尊。","author":{"@type":"Person","name":"骆宾王","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_04195.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_04195","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}