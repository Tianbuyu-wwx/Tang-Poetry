{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_57055","headline":"老相 · 傅翕","name":"老相","inLanguage":"zh-Hans","text":"览镜容颜改，登阶气力衰。\n咄哉今已老，趋拜礼还亏。\n身似临崖树，心如念水龟。\n尚犹躭有漏，不肯学无爲。","author":{"@type":"Person","name":"傅翕","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_57055.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_57055","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"五言律诗","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}