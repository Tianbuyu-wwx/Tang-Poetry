{"@context":"https://schema.org","@type":"Article","@id":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_49456","headline":"荷叶杯 六 · 顾敻","name":"荷叶杯 六","inLanguage":"zh-Hans","text":"我忆君诗最苦，知否，字字尽关心。\n红牋写寄表情深，吟摩吟，吟摩吟。","author":{"@type":"Person","name":"顾敻","nationality":"唐"},"publisher":{"@type":"Organization","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"image":"https://tianbuyu-wwx.github.io/Tang-Poetry/og/open_49456.png","mainEntityOfPage":"https://tianbuyu-wwx.github.io/Tang-Poetry/poem.html?id=open_49456","isPartOf":{"@type":"WebSite","name":"石湖诗社","url":"https://tianbuyu-wwx.github.io/Tang-Poetry/"},"genre":"古风","abstract":"收录于https://github.com/chinese-poetry/chinese-poetry"}